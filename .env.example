# Postgres (Neon via the Vercel Marketplace sets this). Leave empty locally to use an embedded PGlite database in .data/
DATABASE_URL=
# Long random string used to hash login codes / tokens
AUTH_SECRET=change-me-to-a-long-random-string
# 1 = judging/demo environment: shows the persona sign-in page and surfaces login codes for seeded demo accounts only
DEMO_MODE=1
# Optional: real email delivery for login codes and notifications
RESEND_API_KEY=
EMAIL_FROM="azentio.ai <no-reply@example.com>"
# Optional: AIRA uses Claude when set, otherwise a deterministic extractive summariser
ANTHROPIC_API_KEY=
# Minimum distinct contributing organisations before a shared trend statistic is shown (production value needs sign-off)
MIN_COHORT_ORGS=3
